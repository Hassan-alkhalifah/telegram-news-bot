# Copy this file to ".env" for testing on your PC. Never commit the .env file.
# On GitHub these two values go in: Settings > Secrets and variables > Actions.

# The token @BotFather gave you, like 123456789:AAH...
TELEGRAM_BOT_TOKEN=

# Public channel: its @username, like @mynewschannel
# Private channel: its number, like -1001234567890 (see README, "Private channel")
TELEGRAM_CHANNEL_ID=

# Optional: the Arabic twin channel (both lines are needed, see README Step 6).
# The Arabic channel's @username, like @mynewschannel_ar
TELEGRAM_ARABIC_CHANNEL_ID=
# Your DeepL API Free key (it ends in :fx)
DEEPL_API_KEY=
